{
  "name": "audio-connections",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "vite",
    "dev:https": "VITE_HTTPS=1 vite --host",
    "build": "tsc --noEmit && vite build",
    "wasm:build": "bash wasm/build.sh",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:itunes": "vitest run --config vitest.itunes.config.ts",
    "test:itunes:all": "ITUNES_CHECK_SCOPE=all vitest run --config vitest.itunes.config.ts",
    "test:watch": "vitest",
    "test:past-days": "node scripts/check-past-days.ts",
    "check:reuse": "node scripts/check-reuse.ts",
    "puzzle": "node scripts/puzzle.ts",
    "itunes:search": "node scripts/puzzle.ts search",
    "itunes:lookup": "node scripts/puzzle.ts lookup",
    "backlog:preview": "node scripts/schedule-preview.ts --backlog-only",
    "schedule:preview": "node scripts/schedule-preview.ts",
    "validate": "pnpm run typecheck && pnpm run test:unit && pnpm run test:itunes && pnpm run test:past-days",
    "setup": "pnpm install --frozen-lockfile && pnpm exec playwright install && git config core.hooksPath .githooks"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
